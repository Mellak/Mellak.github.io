{%- comment -%}
  Project popup, rendered next to its publication by _layouts/bib.liquid.
  Parameters: project (an entry of site.data.projects), entry (the bibliography entry).
{%- endcomment -%}
{%- assign p = include.project -%}
{%- assign e = include.entry -%}
{%- assign dialog_bibtex_id = p.id | prepend: 'popup-bibtex-' -%}
<dialog class="project-dialog" id="project-{{ p.id }}" data-project="{{ p.id }}" aria-labelledby="project-{{ p.id }}-title">
  <button type="button" class="project-dialog-close" data-project-close aria-label="Close">
    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
  </button>
  <div class="project-dialog-inner">
    <header class="project-dialog-header">
      <span class="venue-badge">{{ p.venue }} {{ p.year }}</span>
      <h2 class="project-dialog-title" id="project-{{ p.id }}-title">{{ p.title }}</h2>
      <ul class="project-authors">
        {%- for author in p.authors %}
          <li{% if author.self %} class="self"{% endif %}>
            {{- author.name -}}
            {%- if author.aff -%}<sup>{{ author.aff | join: ',' }}</sup>{%- endif -%}{%- unless forloop.last -%},{%- endunless -%}</li>
        {%- endfor %}
      </ul>
      <ul class="project-affiliations">
        {%- for affiliation in p.affiliations %}
          <li><sup>{{ forloop.index }}</sup>{{ affiliation }}</li>
        {%- endfor %}
      </ul>
      {%
        include pill_buttons.liquid
        doi=e.doi
        publication=e.url
        arxiv=e.arxiv
        pdf=e.pdf
        code=e.code
        bibtex_id=dialog_bibtex_id
        website=e.website
      %}
    </header>

    <section class="project-section">
      <h3>Abstract</h3>
      <div class="project-abstract"><p>{{ p.abstract }}</p></div>
    </section>

    {%- assign previous_kind = '' -%}
    {%- for figure in p.figures %}
      <section class="project-section">
        {%- if figure.kind != previous_kind %}
          <h3>{% if figure.kind == 'method' %}Method overview{% else %}Key results{% endif %}</h3>
        {%- endif %}
        <figure class="project-figure{% if figure.narrow %} project-figure-narrow{% endif %}">
          <img
            src="{{ figure.src | prepend: '/assets/img/projects/' | relative_url }}"
            alt="{{ figure.alt | escape }}"
            width="{{ figure.width }}"
            height="{{ figure.height }}"
            loading="lazy"
            decoding="async"
          >
          <figcaption><strong>Figure {{ forloop.index }}.</strong> {{ figure.caption }}</figcaption>
        </figure>
      </section>
      {%- assign previous_kind = figure.kind -%}
    {%- endfor %}

    <section class="project-section">
      <h3>BibTeX</h3>
      {% include bibtex_block.liquid id=dialog_bibtex_id bibtex=e.bibtex open=true %}
    </section>
  </div>
</dialog>
