{%- comment -%} Project card. Parameter: project (an entry of site.data.projects). {%- endcomment -%}
{%- assign p = include.project -%}
{%- assign card_bibtex_id = p.id | prepend: 'card-bibtex-' -%}
<article class="project-card" data-project-card="{{ p.id }}">
  <div class="project-icon">{% include project_icons/{{ p.icon }}.svg %}</div>
  <div class="project-card-body">
    <a class="project-card-title" href="{{ '/projects/' | relative_url }}#{{ p.id }}" data-project-open="{{ p.id }}">{{ p.short_title }}</a>
    <span class="venue-badge">{{ p.venue }} {{ p.year }}</span>
    <p class="project-tldr">{{ p.tldr }}</p>
    {%
      include pill_buttons.liquid
      doi=p.links.doi
      arxiv=p.links.arxiv
      pdf=p.links.pdf
      code=p.links.code
      bibtex_id=card_bibtex_id
      project=p.id
    %}
    {%- assign card_bibtex = p.bib | bibtex_for -%}
    {% include bibtex_block.liquid id=card_bibtex_id bibtex=card_bibtex %}
  </div>
</article>
